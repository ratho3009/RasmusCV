---
// En Astro-side
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

const projects = [
	{
		href: "/catandcapy",
		src: "/catandcapyheader.jpg",
		alt: "Cat and Capy Project",
		title: "Cat & Capy",
		meta: "Matato Games",
	},
	{
		href: "/catandcapy",
		src: "/perfectsplithero.png",
		alt: "Perfect Split Project",
		title: "Perfect Split",
	},
	{
		href: "/catandcapy",
		src: "/schibsted.png",
		alt: "Schibsted Project",
		title: "MA-Times",
		meta: "Schibsted",
	},
];

const pathways = [
	{
		href: "/tech",
		src: "/coding.jpg",
		alt: "Coding gallery selection",
		label: "01",
		title: "Tech & IT",
		text: "Dive into my technical portfolio as an IT graduate. Explore my software development projects, academic coursework, AI implementations, and game design.",
	},
	{
		href: "/music",
		src: "/pianopicture.jpg",
		alt: "Piano gallery selection",
		label: "02",
		title: "Music & Art",
		text: "Discover my musical journey, creative projects, and professional services — including bookings, private lessons, and original releases.",
	},
];
---

<Layout title="Rasmus Thorkildsen — Portfolio">
	<Header />

	<main>
		<!-- Hero -->
		<section class="container-page py-section">
			<div
				class="grid items-center gap-block md:grid-cols-[1fr_auto] md:gap-section"
			>
				<div class="animate-fade-in-up">
					<p class="eyebrow">IT graduate · MSc student · Pianist</p>
					<h1 class="mt-4 text-fluid-4xl leading-[1.05] text-balance">
						Rasmus Thorkildsen
					</h1>
					<p
						class="mt-6 max-w-2xl text-fluid-base leading-relaxed text-ink-muted"
					>
						Hi, I'm Rasmus Thorkildsen. Originally from Kristiansand and
						currently based in Trondheim, I am an IT graduate with a
						deep passion for music. I hold a Bachelor's degree in IT,
						have completed a one-year program in music, and am currently
						pursuing my Master of Science in IT. This website serves as
						my digital portfolio, bridging my two main passions. Below,
						you can explore my dual background by diving into either my
						technical projects or my creative musical endeavors.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a
							href="#work"
							class="inline-flex items-center rounded-full bg-accent px-6 py-3 text-fluid-sm font-medium text-surface transition-colors hover:bg-accent-hover"
						>
							View my work
						</a>
						<a
							href="/contact"
							class="inline-flex items-center rounded-full border border-line bg-surface px-6 py-3 text-fluid-sm font-medium text-ink transition-colors hover:border-ink"
						>
							Get in touch
						</a>
					</div>
				</div>

				<figure
					class="order-first mx-auto w-[clamp(11rem,40vw,22rem)] md:order-none animate-fade-in"
				>
					<img
						src="/RasmusThorkildsenPhoto2.PNG"
						alt="Rasmus Thorkildsen Portrait"
						class="block w-full rounded-2xl object-cover shadow-[0_24px_48px_-24px_rgb(17_27_46/0.35)] ring-1 ring-line"
					/>
				</figure>
			</div>
		</section>

		<!-- Prosjekter -->
		<section id="work" class="scroll-mt-20 border-t border-line bg-surface">
			<div class="container-page py-section">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<div>
						<p class="eyebrow">Selected work</p>
						<h2 class="mt-3 text-fluid-2xl text-balance">
							Projects I have worked on
						</h2>
					</div>
					<a
						href="/tech"
						class="text-fluid-sm font-medium text-accent hover:text-accent-hover"
					>
						All tech projects →
					</a>
				</div>

				<ul
					class="mt-block grid grid-cols-1 gap-grid sm:grid-cols-2 lg:grid-cols-3"
				>
					{
						projects.map((project) => (
							<li>
								<a href={project.href} class="group block h-full">
									<div class="overflow-hidden rounded-xl border border-line bg-sunken">
										<img
											src={project.src}
											alt={project.alt}
											loading="lazy"
											class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
										/>
									</div>
									<div class="mt-4 flex items-baseline justify-between gap-4">
										<h3 class="text-fluid-lg">
											{project.title}
										</h3>
										{project.meta && (
											<span class="shrink-0 text-fluid-sm text-ink-faint">
												{project.meta}
											</span>
										)}
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- To retninger -->
		<section class="border-t border-line">
			<div class="container-page py-section">
				<div class="max-w-2xl">
					<p class="eyebrow">Two disciplines</p>
					<h2 class="mt-3 text-fluid-2xl text-balance">
						Explore more of my work
					</h2>
				</div>

				<ul class="mt-block grid grid-cols-1 gap-grid md:grid-cols-2">
					{
						pathways.map((pathway) => (
							<li>
								<a
									href={pathway.href}
									class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-shadow duration-300 hover:shadow-[0_20px_40px_-24px_rgb(17_27_46/0.3)]"
								>
									<div class="overflow-hidden">
										<img
											src={pathway.src}
											alt={pathway.alt}
											loading="lazy"
											class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
										/>
									</div>
									<div class="flex flex-1 flex-col p-gutter">
										<span class="text-xs font-semibold tracking-[0.14em] text-ink-faint">
											{pathway.label}
										</span>
										<h3 class="mt-2 text-fluid-xl">
											{pathway.title}
										</h3>
										<p class="mt-3 flex-1 text-fluid-sm leading-relaxed text-ink-muted">
											{pathway.text}
										</p>
										<span class="mt-6 self-start whitespace-nowrap text-fluid-sm font-medium text-accent transition-transform group-hover:translate-x-1">
											Explore {pathway.title} →
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>
</Layout>
