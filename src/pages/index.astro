---
// En Astro-side
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import GlowBlob from "../components/GlowBlob.astro"; // Import your new component

const projects = [
	{
		href: "/catandcapy",
		src: "/catandcapyheader.jpg",
		alt: "Cat and Capy Project",
		title: "Cat & Capy by Matato Games",
	},
	{
		href: "/catandcapy",
		src: "/perfectsplithero.png",
		alt: "Perfect Split Project",
		title: "Perfect Split",
	},
	{
		href: "/catandcapy",
		src: "/schibsted.png",
		alt: "Schibsted Project",
		title: "MA-Times for Schibsted",
	},
];

const pathways = [
	{
		href: "/music",
		src: "/pianopicture.jpg",
		alt: "Piano gallery selection",
		title: "Music & Art",
		text: "Discover my musical journey, creative projects, and professional services — including bookings, private lessons, and original releases.",
	},
	{
		href: "/tech",
		src: "/coding.jpg",
		alt: "Coding gallery selection",
		title: "Tech & IT",
		text: "Dive into my technical portfolio as an IT graduate. Explore my software development projects, academic coursework, AI implementations, and game design.",
	},
];
---

<Layout title="Rasmus Thorkildsen — Portfolio">
	<Header />

	<main class="relative isolate overflow-hidden min-h-screen bg-gray-950">
		<GlowBlob color="teal" class="top-0 -left-1/4 rotate-[-15deg]" />
		<GlowBlob
			color="purple"
			class="top-1/3 -right-1/4 rotate-[30deg] opacity-10"
		/>
		<GlowBlob color="blue" class="bottom-[-15vw] left-1/4" />

		<div class="container-page animate-fade-in py-section">
			<section>
				<h1
					class="text-fluid-3xl font-bold text-teal-400 text-center md:text-left animate-fade-in-up text-balance"
				>
					Who am i?
				</h1>

				<div
					class="mt-block flex flex-col-reverse items-center gap-block md:flex-row md:items-start md:justify-between"
				>
					<p
						class="max-w-2xl text-fluid-base leading-relaxed text-white text-center md:text-left"
					>
						Hi, I'm Rasmus Thorkildsen. Originally from Kristiansand and
						currently based in Trondheim, I am an IT graduate with a
						deep passion for music. I hold a Bachelor's degree in IT,
						have completed a one-year program in music, and am currently
						pursuing my Master of Science in IT. This website serves as
						my digital portfolio, bridging my two main passions. Below,
						you can explore my dual background by diving into either my
						technical projects or my creative musical endeavors.
					</p>
					<img
						src="/RasmusThorkildsenPhoto2.PNG"
						alt="Rasmus Thorkildsen Portrait"
						class="block w-[clamp(9rem,32vw,16rem)] shrink-0 overflow-hidden rounded-lg shadow-lg shadow-teal-500/20"
					/>
				</div>
			</section>

			<section class="mt-section">
				<h2
					class="text-fluid-2xl font-bold text-teal-400 text-center animate-fade-in-up text-balance"
				>
					Some projects i have worked on
				</h2>

				<ul
					class="mt-block grid grid-cols-1 gap-grid sm:grid-cols-2 lg:grid-cols-3"
				>
					{
						projects.map((project) => (
							<li>
								<a
									href={project.href}
									class="group block h-full overflow-hidden transition-transform duration-300 hover:-translate-y-2"
								>
									<img
										src={project.src}
										alt={project.alt}
										loading="lazy"
										class="aspect-[16/10] w-full rounded-xl border border-gray-800 object-cover shadow-lg"
									/>
									<span class="block pt-4 text-center text-fluid-base font-semibold text-white drop-shadow-md text-balance">
										{project.title}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="mt-section pb-block animate-fade-in">
				<h3
					class="text-fluid-2xl font-bold text-teal-400 text-center animate-fade-in-up text-balance"
				>
					Select a pathway to explore more my work
				</h3>

				<ul
					class="animate-slide-in-top mt-block mx-auto grid max-w-4xl grid-cols-1 gap-grid sm:grid-cols-2"
				>
					{
						pathways.map((pathway) => (
							<li>
								<a
									href={pathway.href}
									class="group relative block h-full overflow-hidden rounded-xl border border-gray-800 bg-slate-950 shadow-xl transition-colors hover:border-teal-500/50"
								>
									<img
										src={pathway.src}
										alt={pathway.alt}
										loading="lazy"
										class="aspect-[4/3] w-full object-cover transition-all duration-500 group-hover:brightness-50 group-hover:scale-105"
									/>
									<h2 class="absolute inset-x-0 top-4 z-10 text-center text-fluid-xl font-bold text-white drop-shadow-lg">
										{pathway.title}
									</h2>
									<div class="absolute inset-0 flex items-center justify-center bg-black/40 p-gutter opacity-0 transition-opacity duration-300 group-hover:opacity-100">
										<span class="mt-8 text-center text-fluid-sm font-medium leading-relaxed text-white drop-shadow-md">
											{pathway.text}
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</main>
</Layout>
