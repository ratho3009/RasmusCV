---
// En Astro-side
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import VideoScroll from "../components/VideoScroll.astro";

const tracks = [
    "2yliUWZhYKmMKfGBvBYG3P",
    "3xG3HQPV6sYkSrZ6YDCN7v",
    "77KV71TOuQKxJh0xAqiENG",
];
---

<Layout title="Music — Rasmus Thorkildsen">
    <Header />

    <main class="container-page py-section">
        <section>
            <h1
                class="text-fluid-3xl font-extrabold tracking-tight text-teal-400 animate-fade-in-up text-balance"
            >
                About my music
            </h1>

            <div
                class="mt-block flex flex-col items-center gap-block rounded-2xl border border-gray-700/30 bg-gray-800/20 p-gutter shadow-xl backdrop-blur-sm animate-fade-in-up md:flex-row md:p-block"
            >
                <div class="flex-1 space-y-4">
                    <p
                        class="text-fluid-lg font-semibold italic text-teal-300/90 text-balance"
                    >
                        "Every song tells a story, and the keys are where they
                        begin."
                    </p>
                    <p class="text-fluid-base leading-relaxed text-gray-300">
                        I've been immersed in music my whole life. From writing
                        my first raw songs to meticulously crafting intricate
                        piano melodies, creating music is how I capture emotions
                        and share them with the world. Whether it's stripping a
                        famous pop track down to its bare acoustic roots or
                        assembling massive layers in the studio, my goal is
                        always the same: authentic connection.
                    </p>
                </div>

                <div
                    class="group relative w-[clamp(12rem,45vw,18rem)] shrink-0"
                >
                    <div
                        class="absolute inset-0 rounded-xl bg-teal-500/10 blur-xl transition-all duration-500 group-hover:bg-teal-500/20"
                    >
                    </div>

                    <img
                        src="/pianoplaceholder.png"
                        class="relative z-10 aspect-square w-full rounded-xl border border-gray-700/50 object-cover shadow-2xl transition-all duration-500 group-hover:scale-[1.03] group-hover:border-teal-500/40"
                        alt="Piano performance portrait"
                    />
                </div>
            </div>
        </section>

        <div class="my-section flex w-full justify-center">
            <div
                class="inline-flex rounded-full bg-gray-800/50 p-1 shadow-inner"
            >
                <button
                    id="btn-live"
                    class="cursor-pointer rounded-full bg-teal-400 px-4 py-2 text-fluid-sm font-bold text-gray-900 shadow-md transition-all duration-300 sm:px-6"
                >
                    Live Performance
                </button>
                <button
                    id="btn-prod"
                    class="cursor-pointer rounded-full px-4 py-2 text-fluid-sm font-bold text-white transition-all duration-300 hover:text-teal-300 sm:px-6"
                >
                    Music Production
                </button>
            </div>
        </div>

        <div class="mx-auto w-full max-w-4xl pb-block">
            <section id="content-live" class="block animate-fade-in-up">
                <h2 class="mb-4 text-fluid-2xl font-bold text-teal-400">
                    Live Performance
                </h2>
                <p
                    class="max-w-2xl pt-4 text-fluid-base leading-relaxed text-white"
                >
                    I've been immersed in music my entire life. Whether I'm
                    writing original songs or putting my own spin on popular
                    tracks, sitting at the piano is where I feel most at home.
                    For me, live performance is all about connection—taking a
                    piece of music, stripping it down to the keys, and sharing
                    that raw energy and emotion with an audience.
                </p>
                <h2
                    class="mt-block mb-block text-fluid-2xl font-bold text-teal-400 animate-fade-in-up text-balance"
                >
                    Some of the Piano covers I have made
                </h2>
                <VideoScroll />
            </section>

            <section id="content-prod" class="hidden animate-fade-in-up">
                <h2 class="mb-4 text-fluid-2xl font-bold text-teal-400">
                    Music Production
                </h2>
                <p
                    class="max-w-2xl pt-4 text-fluid-base leading-relaxed text-white"
                >
                    While live performance is about the raw energy of the
                    moment, the studio is where I get to build an entire sonic
                    world from the ground up. Music production allows me to take
                    a single piano chord or a fleeting idea and sculpt it into a
                    fully realized track. Whether I'm layering instruments,
                    dialing in the perfect mix, or experimenting with sound
                    design, the studio is where my broader creative vision comes
                    to life.
                </p>

                <h2
                    class="mt-block mb-block text-fluid-2xl font-bold text-teal-400 animate-fade-in-up text-balance"
                >
                    Listen to my latest tracks
                </h2>

                <div
                    class="grid w-full grid-cols-1 gap-grid sm:grid-cols-2 lg:grid-cols-3"
                >
                    {
                        tracks.map((id) => (
                            <iframe
                                src={`https://open.spotify.com/embed/track/${id}?utm_source=generator`}
                                title="Spotify track"
                                height="352"
                                frameborder="0"
                                allowfullscreen
                                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                                loading="lazy"
                                class="w-full rounded-xl shadow-lg transition-transform duration-300 hover:scale-[1.02]"
                            />
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Layout>

<script>
    // Fanebytte mellom "Live Performance" og "Music Production".
    // Ligger her fordi knappene og innholdsblokkene tilhører denne siden.
    const btnLive = document.getElementById("btn-live") as HTMLButtonElement;
    const btnProd = document.getElementById("btn-prod") as HTMLButtonElement;
    const contentLive = document.getElementById(
        "content-live",
    ) as HTMLDivElement;
    const contentProd = document.getElementById(
        "content-prod",
    ) as HTMLDivElement;

    const activeClasses = ["bg-teal-400", "text-gray-900", "shadow-md"];
    const inactiveClasses = [
        "text-white",
        "hover:text-teal-300",
        "bg-transparent",
        "shadow-none",
    ];

    function setButtonActive(
        activeBtn: HTMLButtonElement,
        inactiveBtn: HTMLButtonElement,
    ) {
        activeBtn.classList.remove(...inactiveClasses);
        activeBtn.classList.add(...activeClasses);

        inactiveBtn.classList.remove(...activeClasses);
        inactiveBtn.classList.add(...inactiveClasses);
    }

    if (btnLive && btnProd) {
        btnLive.addEventListener("click", () => {
            setButtonActive(btnLive, btnProd);
            contentLive.classList.remove("hidden");
            contentLive.classList.add("block");
            contentProd.classList.remove("block");
            contentProd.classList.add("hidden");
        });

        btnProd.addEventListener("click", () => {
            setButtonActive(btnProd, btnLive);
            contentProd.classList.remove("hidden");
            contentProd.classList.add("block");
            contentLive.classList.remove("block");
            contentLive.classList.add("hidden");
        });
    }
</script>
