---
// En Astro-side
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — Rasmus Thorkildsen">
    <Header />
    <main class="py-section">
        <div class="container-prose">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Contact</p>
                <h1 class="mt-3 text-fluid-3xl text-balance">Get in touch</h1>
                <p class="mt-4 text-fluid-lg leading-relaxed text-ink-muted">
                    Job opportunities, collaborations, bookings or piano
                    lessons — send me a message and I'll get back to you.
                </p>
            </div>
            <form
                action="#"
                method="POST"
                class="mx-auto mt-block max-w-xl rounded-2xl border border-line bg-surface p-gutter"
            >
                <div class="grid grid-cols-1 gap-x-grid gap-y-6 sm:grid-cols-2">
                    <div>
                        <label
                            for="first-name"
                            class="block text-sm/6 font-medium text-ink"
                            >First name</label
                        >
                        <div class="mt-2.5">
                            <input
                                id="first-name"
                                type="text"
                                name="first-name"
                                autocomplete="given-name"
                                class="block w-full rounded-md bg-paper px-3.5 py-2 text-base/6 text-ink outline-1 -outline-offset-1 outline-line placeholder:text-ink-faint focus:outline-2 focus:-outline-offset-2 focus:outline-accent"
                            />
                        </div>
                    </div>
                    <div>
                        <label
                            for="last-name"
                            class="block text-sm/6 font-medium text-ink"
                            >Last name</label
                        >
                        <div class="mt-2.5">
                            <input
                                id="last-name"
                                type="text"
                                name="last-name"
                                autocomplete="family-name"
                                class="block w-full rounded-md bg-paper px-3.5 py-2 text-base/6 text-ink outline-1 -outline-offset-1 outline-line placeholder:text-ink-faint focus:outline-2 focus:-outline-offset-2 focus:outline-accent"
                            />
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <label
                            for="company"
                            class="block text-sm/6 font-medium text-ink"
                            >Company</label
                        >
                        <div class="mt-2.5">
                            <input
                                id="company"
                                type="text"
                                name="company"
                                autocomplete="organization"
                                class="block w-full rounded-md bg-paper px-3.5 py-2 text-base/6 text-ink outline-1 -outline-offset-1 outline-line placeholder:text-ink-faint focus:outline-2 focus:-outline-offset-2 focus:outline-accent"
                            />
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <label
                            for="email"
                            class="block text-sm/6 font-medium text-ink"
                            >Email</label
                        >
                        <div class="mt-2.5">
                            <input
                                id="email"
                                type="email"
                                name="email"
                                autocomplete="email"
                                class="block w-full rounded-md bg-paper px-3.5 py-2 text-base/6 text-ink outline-1 -outline-offset-1 outline-line placeholder:text-ink-faint focus:outline-2 focus:-outline-offset-2 focus:outline-accent"
                            />
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <label
                            for="phone-number"
                            class="block text-sm/6 font-medium text-ink"
                            >Phone number</label
                        >
                        <div class="mt-2.5">
                            <div
                                class="flex rounded-md bg-paper outline-1 -outline-offset-1 outline-line has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-accent"
                            >
                                <div
                                    class="grid shrink-0 grid-cols-1 focus-within:relative"
                                >
                                    <select
                                        id="country"
                                        name="country"
                                        autocomplete="country"
                                        aria-label="Country"
                                        class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-transparent py-2 pr-7 pl-3.5 text-base text-ink-muted placeholder:text-ink-faint focus:outline-2 focus:-outline-offset-2 focus:outline-accent sm:text-sm/6"
                                    >
                                        <option>US</option>
                                        <option>CA</option>
                                        <option>EU</option>
                                    </select>
                                    <svg
                                        viewBox="0 0 16 16"
                                        fill="currentColor"
                                        data-slot="icon"
                                        aria-hidden="true"
                                        class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-ink-muted sm:size-4"
                                    >
                                        <path
                                            d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"
                                            clip-rule="evenodd"
                                            fill-rule="evenodd"></path>
                                    </svg>
                                </div>
                                <input
                                    id="phone-number"
                                    type="text"
                                    name="phone-number"
                                    placeholder="123-456-7890"
                                    class="block min-w-0 grow bg-transparent py-1.5 pr-3 pl-1 text-base text-ink placeholder:text-ink-faint focus:outline-none sm:text-sm/6"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <label
                            for="message"
                            class="block text-sm/6 font-medium text-ink"
                            >Message</label
                        >
                        <div class="mt-2.5">
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                class="block w-full rounded-md bg-paper px-3.5 py-2 text-base/6 text-ink outline-1 -outline-offset-1 outline-line placeholder:text-ink-faint focus:outline-2 focus:-outline-offset-2 focus:outline-accent"
                            ></textarea>
                        </div>
                    </div>
                    <div class="flex gap-x-4 sm:col-span-2">
                        <div class="flex h-6 items-center">
                            <div
                                class="group relative inline-flex w-8 shrink-0 rounded-full bg-paper p-px inset-ring inset-ring-line outline-offset-2 outline-accent transition-colors duration-200 ease-in-out has-checked:bg-accent has-focus-visible:outline-2"
                            >
                                <span
                                    class="size-4 rounded-full bg-white shadow-xs ring-1 ring-ink/10 transition-transform duration-200 ease-in-out group-has-checked:translate-x-3.5"
                                ></span>
                                <input
                                    id="agree-to-policies"
                                    type="checkbox"
                                    name="agree-to-policies"
                                    aria-label="Agree to policies"
                                    class="absolute inset-0 size-full appearance-none focus:outline-hidden"
                                />
                            </div>
                        </div>
                        <label
                            for="agree-to-policies"
                            class="text-sm/6 text-ink-muted"
                        >
                            By selecting this, you agree to our
                            <a
                                href="#"
                                class="font-semibold whitespace-nowrap text-accent"
                                >privacy policy</a
                            >.
                        </label>
                    </div>
                </div>
                <div class="mt-block">
                    <button
                        type="submit"
                        class="block w-full rounded-full bg-accent px-3.5 py-3 text-center text-fluid-sm font-medium text-surface hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                        >Let's talk</button
                    >
                </div>
            </form>
        </div>
    </main>
</Layout>
