---
// src/components/VideoScroll.astro
import { Icon } from "astro-icon/components";

const videoIds = [
    "7647510065221602582",
    "7640552327224511766",
    "7638966279818202390",
];
---

<div
    class="relative mx-auto my-block flex w-full max-w-5xl items-center justify-center overflow-hidden h-[clamp(22rem,78vw,27rem)]"
>
    <button
        id="previous-btn"
        aria-label="Previous video"
        class="absolute left-0 z-20 cursor-pointer rounded-full border border-line bg-surface p-2.5 text-ink shadow-sm transition-colors hover:border-ink sm:left-4 lg:left-10"
    >
        <Icon
            name="fa6-solid:angle-left"
            class="size-4 sm:size-5"
        />
    </button>

    {
        videoIds.map((id, i) => (
            <iframe
                id={`vid-${i}`}
                src={`https://www.tiktok.com/player/v1/${id}?autoplay=0`}
                title="TikTok video"
                class="carousel-video absolute aspect-[9/16] w-[clamp(10rem,42vw,14rem)] rounded-xl border-none shadow-lg transition-all duration-500 ease-in-out"
                allow="fullscreen"
                loading="lazy"
            />
        ))
    }

    <button
        id="next-btn"
        aria-label="Next video"
        class="absolute right-0 z-20 cursor-pointer rounded-full border border-line bg-surface p-2.5 text-ink shadow-sm transition-colors hover:border-ink sm:right-4 lg:right-10"
    >
        <Icon
            name="fa6-solid:angle-right"
            class="size-4 sm:size-5"
        />
    </button>
</div>

<script>
    // Grab all elements
    const videos = document.querySelectorAll(
        ".carousel-video",
    ) as NodeListOf<HTMLIFrameElement>;
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
    const prevBtn = document.getElementById(
        "previous-btn",
    ) as HTMLButtonElement;

    // We define the 3 layout states as strings of Tailwind classes.
    // Forskyvningen er i prosent av videoens egen bredde, slik at kortene
    // holder samme innbyrdes plassering uansett hvor bred skjermen er.
    const states = [
        "-translate-x-[70%] sm:-translate-x-[95%] scale-75 opacity-40 z-0 pointer-events-none", // 0: Left State
        "translate-x-0 scale-100 opacity-100 z-10 shadow-xl pointer-events-auto", // 1: Center State
        "translate-x-[70%] sm:translate-x-[95%] scale-75 opacity-40 z-0 pointer-events-none", // 2: Right State
    ];

    // This array maps each video (by index) to a state index above.
    // Start layout: Video 0 is Left, Video 1 is Center, Video 2 is Right.
    let currentPositions = [0, 1, 2];

    function applyPositions() {
        videos.forEach((vid, i) => {
            // First, strip away ALL possible state classes so we have a clean slate
            states.forEach((stateGroup) => {
                const classArray = stateGroup.split(" ");
                vid.classList.remove(...classArray);
            });

            // Now, apply the specific classes for this video's current position
            const currentStateIndex = currentPositions[i];
            const classesToAdd = states[currentStateIndex].split(" ");
            vid.classList.add(...classesToAdd);
        });
    }

    // NEXT BUTTON LOGIC
    if (nextBtn) {
        nextBtn.addEventListener("click", () => {
            // Math magic: Shifts the positions array right
            currentPositions = currentPositions.map((pos) => (pos + 2) % 3);
            applyPositions();
        });
    }

    // PREVIOUS BUTTON LOGIC
    if (prevBtn) {
        prevBtn.addEventListener("click", () => {
            // Math magic: Shifts the positions array left
            currentPositions = currentPositions.map((pos) => (pos + 1) % 3);
            applyPositions();
        });
    }

    // Run this once when the page loads to snap everything into place
    applyPositions();
</script>
