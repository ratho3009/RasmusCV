---
// src/components/Header.astro
import { Icon } from "astro-icon/components";
import { socials } from "../data/socials";

const navItems = [
    { label: "Home", href: "/" },
    { label: "Tech", href: "/tech" },
    { label: "Music", href: "/music" },
    { label: "Contact", href: "/contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
    class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md"
>
    <nav
        class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3 sm:min-h-18 sm:py-0"
    >
        <a
            href="/"
            class="flex items-center gap-3 text-ink"
            aria-label="Rasmus Thorkildsen — home"
        >
            <img src="/rt-logo.png" alt="" class="h-7 w-auto" />
            <span class="hidden font-display text-lg sm:inline">
                Rasmus Thorkildsen
            </span>
        </a>

        <div class="flex items-center gap-x-6 sm:gap-x-10">
            <ul class="flex items-center gap-x-5 text-fluid-sm sm:gap-x-7">
                {
                    navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                aria-current={path === item.href ? "page" : null}
                                class="relative py-1 text-ink-muted transition-colors hover:text-ink aria-[current=page]:text-ink after:absolute after:inset-x-0 after:-bottom-px after:h-px after:scale-x-0 after:bg-accent after:transition-transform aria-[current=page]:after:scale-x-100 hover:after:scale-x-100"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>

            <ul
                class="hidden items-center gap-x-4 border-l border-line pl-6 md:flex"
            >
                {
                    socials.map((social) => (
                        <li>
                            <a
                                href={social.href}
                                aria-label={social.label}
                                class="block text-ink-faint transition-colors hover:text-accent"
                            >
                                <Icon name={social.icon} class="size-4" />
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </nav>
</header>
